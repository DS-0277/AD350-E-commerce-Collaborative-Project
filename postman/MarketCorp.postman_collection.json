{
      "info": {
              "name": "MarketCorp API",
              "_postman_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
              "description": "Postman collection for the MarketCorp e-commerce API. All requests use the Supabase PostgREST endpoint for the products table.\n\nCollection Variables:\n- SUPABASE_URL: Base URL for the Supabase project\n- SUPABASE_ANON_KEY: Public anon key for read access\n\nSetup:\n1. Set SUPABASE_URL = https://sjfwzwqynuykrqdmgtfl.supabase.co\n2. Set SUPABASE_ANON_KEY = your legacy anon key from Supabase dashboard\n\nNote: Two requests require a real product UUID. Replace PASTE_UUID_HERE using:\n  SELECT id, name FROM products LIMIT 1;",
              "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
      },
      "variable": [
              {
                        "key": "SUPABASE_URL",
                        "value": "https://sjfwzwqynuykrqdmgtfl.supabase.co",
                        "type": "string",
                        "description": "Base URL for the Supabase project. Set this to your Supabase project URL."
              },
              {
                        "key": "SUPABASE_ANON_KEY",
                        "value": "",
                        "type": "string",
                        "description": "Supabase legacy anon key. Copy from Supabase dashboard under Project Settings > API > Project API keys > anon (public). Do not hardcode this value."
              }
      ],
      "item": [
              {
                        "name": "GET all products",
                        "request": {
                                    "method": "GET",
                                    "header": [
                                                  { "key": "apikey", "value": "{{SUPABASE_ANON_KEY}}", "type": "text" },
                                                  { "key": "Authorization", "value": "Bearer {{SUPABASE_ANON_KEY}}", "type": "text" }
                                    ],
                                    "url": {
                                                  "raw": "{{SUPABASE_URL}}/rest/v1/products?select=*&order=created_at.desc",
                                                  "host": ["{{SUPABASE_URL}}"],
                                                  "path": ["rest", "v1", "products"],
                                                  "query": [
                                                                  { "key": "select", "value": "*" },
                                                                  { "key": "order", "value": "created_at.desc" }
                                                  ]
                                    },
                                    "description": "Returns the full product catalog ordered by newest first.\n\nExpected: 200 OK — array of all 12 products."
                        },
                        "response": []
              },
              {
                        "name": "GET featured products",
                        "request": {
                                    "method": "GET",
                                    "header": [
                                                  { "key": "apikey", "value": "{{SUPABASE_ANON_KEY}}", "type": "text" },
                                                  { "key": "Authorization", "value": "Bearer {{SUPABASE_ANON_KEY}}", "type": "text" }
                                    ],
                                    "url": {
                                                  "raw": "{{SUPABASE_URL}}/rest/v1/products?select=*&is_featured=eq.true&limit=4",
                                                  "host": ["{{SUPABASE_URL}}"],
                                                  "path": ["rest", "v1", "products"],
                                                  "query": [
                                                                  { "key": "select", "value": "*" },
                                                                  { "key": "is_featured", "value": "eq.true" },
                                                                  { "key": "limit", "value": "4" }
                                                  ]
                                    },
                                    "description": "Returns up to 4 featured products (is_featured = true).\n\nExpected: 200 OK — array of 4 featured products."
                        },
                        "response": []
              },
              {
                        "name": "GET single product by ID",
                        "request": {
                                    "method": "GET",
                                    "header": [
                                                  { "key": "apikey", "value": "{{SUPABASE_ANON_KEY}}", "type": "text" },
                                                  { "key": "Authorization", "value": "Bearer {{SUPABASE_ANON_KEY}}", "type": "text" }
                                    ],
                                    "url": {
                                                  "raw": "{{SUPABASE_URL}}/rest/v1/products?select=*&id=eq.PASTE_UUID_HERE",
                                      "host": ["{{SUPABASE_URL}}"],
                                      "path": ["rest", "v1", "products"],
                                      "query": [
                                                      { "key": "select", "value": "*" },
                                                      { "key": "id", "value": "eq.PASTE_UUID_HERE" }
                                      ]
                        },
                          "description": "Returns a single product by its UUID.\n\nSetup: Replace PASTE_UUID_HERE with a real product UUID from:\n  SELECT id, name FROM products LIMIT 1;\n\nExpected: 200 OK — array with one product object."
              },
                "response": []
},
    {
              "name": "GET products by category",
              "request": {
                          "method": "GET",
                          "header": [
                                        { "key": "apikey", "value": "{{SUPABASE_ANON_KEY}}", "type": "text" },
                                        { "key": "Authorization", "value": "Bearer {{SUPABASE_ANON_KEY}}", "type": "text" }
                          ],
                          "url": {
                                        "raw": "{{SUPABASE_URL}}/rest/v1/products?select=*&category=eq.Audio&order=rating.desc",
                            "host": ["{{SUPABASE_URL}}"],
                            "path": ["rest", "v1", "products"],
                            "query": [
                                            { "key": "select", "value": "*" },
                                            { "key": "category", "value": "eq.Audio" },
                                            { "key": "order", "value": "rating.desc" }
                            ]
              },
                "description": "Returns all products in the Audio category, ordered by highest rating first.\n\nExpected: 200 OK — 6 Audio products sorted by rating descending.\n\nOther available categories: Seating, Tech, Lighting, Accessories."
    },
      "response": []
},
    {
              "name": "GET products on sale",
              "request": {
                          "method": "GET",
                          "header": [
                                        { "key": "apikey", "value": "{{SUPABASE_ANON_KEY}}", "type": "text" },
                                        { "key": "Authorization", "value": "Bearer {{SUPABASE_ANON_KEY}}", "type": "text" }
                          ],
                          "url": {
                                        "raw": "{{SUPABASE_URL}}/rest/v1/products?select=*&sale_price=not.is.null&order=sale_price.asc",
                            "host": ["{{SUPABASE_URL}}"],
                            "path": ["rest", "v1", "products"],
                            "query": [
                                            { "key": "select", "value": "*" },
                                            { "key": "sale_price", "value": "not.is.null" },
                                            { "key": "order", "value": "sale_price.asc" }
                            ]
              },
                "description": "Returns all products that have a sale_price set, ordered by sale price ascending.\n\nExpected: 200 OK — 4 products on sale."
    },
      "response": []
},
    {
              "name": "GET products by price range",
              "request": {
                          "method": "GET",
                          "header": [
                                        { "key": "apikey", "value": "{{SUPABASE_ANON_KEY}}", "type": "text" },
                                        { "key": "Authorization", "value": "Bearer {{SUPABASE_ANON_KEY}}", "type": "text" }
                          ],
                          "url": {
                                        "raw": "{{SUPABASE_URL}}/rest/v1/products?select=*&price=gte.100&price=lte.400",
                            "host": ["{{SUPABASE_URL}}"],
                            "path": ["rest", "v1", "products"],
                            "query": [
                                            { "key": "select", "value": "*" },
                                            { "key": "price", "value": "gte.100" },
                                            { "key": "price", "value": "lte.400" }
                            ]
              },
                "description": "Returns all products with a price between $100 and $400 (inclusive).\n\nExpected: 200 OK — products within the $100-$400 price range."
    },
      "response": []
},
    {
              "name": "GET products in stock",
              "request": {
                          "method": "GET",
                          "header": [
                                        { "key": "apikey", "value": "{{SUPABASE_ANON_KEY}}", "type": "text" },
                                        { "key": "Authorization", "value": "Bearer {{SUPABASE_ANON_KEY}}", "type": "text" }
                          ],
                          "url": {
                                        "raw": "{{SUPABASE_URL}}/rest/v1/products?select=*&stock=gt.0&order=rating.desc",
                            "host": ["{{SUPABASE_URL}}"],
                            "path": ["rest", "v1", "products"],
                            "query": [
                                            { "key": "select", "value": "*" },
                                            { "key": "stock", "value": "gt.0" },
                                            { "key": "order", "value": "rating.desc" }
                            ]
              },
                "description": "Returns all in-stock products (stock > 0), ordered by highest rating first.\n\nExpected: 200 OK — 11 products (excludes out-of-stock items)."
    },
      "response": []
},
    {
              "name": "GET related products (same category)",
              "request": {
                          "method": "GET",
                          "header": [
                                        { "key": "apikey", "value": "{{SUPABASE_ANON_KEY}}", "type": "text" },
                                        { "key": "Authorization", "value": "Bearer {{SUPABASE_ANON_KEY}}", "type": "text" }
                          ],
                          "url": {
                                        "raw": "{{SUPABASE_URL}}/rest/v1/products?select=*&category=eq.Audio&id=neq.PASTE_UUID_HERE&limit=4",
                            "host": ["{{SUPABASE_URL}}"],
                            "path": ["rest", "v1", "products"],
                            "query": [
                                            { "key": "select", "value": "*" },
                                            { "key": "category", "value": "eq.Audio" },
                                            { "key": "id", "value": "neq.PASTE_UUID_HERE" },
                                            { "key": "limit", "value": "4" }
                            ]
              },
                "description": "Returns up to 4 related Audio products, excluding the current product by UUID.\n\nSetup: Replace PASTE_UUID_HERE with the same UUID used in GET single product by ID.\n\nExpected: 200 OK — up to 4 Audio products excluding the specified product."
    },
      "response": []
}
]
}
